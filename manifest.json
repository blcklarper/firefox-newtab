{
  "name": "firefox-newtab",
  "version": "1.0.1",
  "manifest_version": 3,
  "description": "a custom minimal new tab extension for Firefox / LibreWolf",
  "author": "diggingforce",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["storage", "search"],
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@diggingforce.local",
      "strict_min_version": "117.0"
    }
  }
}
